# msmtp config for Baile Nua v1 alerts. No secret in this file: the Gmail app
# password is read at send time from ~/.mail_baile_nua.env via passwordeval.
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        /home/ubuntu/hrsd_occupants/ops/logs/msmtp.log

account        gmail
host           smtp.gmail.com
port           587
from           brianoregan78@gmail.com
user           brianoregan78@gmail.com
passwordeval   "/home/ubuntu/hrsd_occupants/ops/mail_password.sh 2>/dev/null"

account default : gmail
